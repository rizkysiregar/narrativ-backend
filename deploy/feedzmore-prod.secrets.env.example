# Copy to deploy/feedzmore-prod.secrets.env, fill the values, then copy it to
# /secure/feedzmore/feedzmore-prod.env on the administrator or infra VM.
# PRODUCTION values only: never reuse a dev password or key. Becomes the Kubernetes Secret
# `feedzmore-secrets` in the namespace `feedzmore-prod` (see homelabs-gitops apps/feedzmore-prod/README.md).

# role of the app in infra-postgres-prod (reached through pgbouncer, database alias feedzmore_prod). Not infra_prod_admin.
POSTGRES_USER=feedzmore_prod
POSTGRES_PASSWORD=

# user with access to the vhost /feedzmore-prod. Also read by the media worker.
RABBITMQ_USERNAME=feedzmore_prod
RABBITMQ_FEEDZMORE_PASSWORD=

# password of the dedicated prod redis (port 6380, started with --requirepass)
REDIS_PASSWORD=

MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=

# support address printed on the public privacy policy / terms / account deletion pages. The app does not start without it.
LEGAL_CONTACT_EMAIL=

# base64 key that signs the JWTs. Must differ from dev: whoever has it can forge an admin token. e.g. openssl rand -base64 32
SECRET_KEY=

# access key limited to the bucket feedzmore-prod. Also read by the media worker.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
