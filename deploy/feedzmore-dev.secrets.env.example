# Copy to deploy/feedzmore-dev.secrets.env, fill the values, then copy it to
# /secure/feedzmore/feedzmore-dev.env on the administrator or infra VM.
# This file contains only values that become the Kubernetes Secret.

POSTGRES_USER=
POSTGRES_PASSWORD=
RABBITMQ_USERNAME=
RABBITMQ_FEEDZMORE_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=

# support address printed on the public legal pages (optional in dev)
LEGAL_CONTACT_EMAIL=
SECRET_KEY=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
