# Copy to deploy/narrativ-prod.secrets.env, fill the values, then copy it to
# /secure/narrativ/narrativ-prod.env on the administrator or infra VM.
# PRODUCTION values only: never reuse a dev password or key. Becomes the Kubernetes Secret
# `narrativ-secrets` in the namespace `narrativ` (see homelabs-gitops apps/narrativ/README.md).

# role of the app in infra-postgres-prod (reached through pgbouncer, database alias narrativ). Not infra_prod_admin.
POSTGRES_USER=narrativ
POSTGRES_PASSWORD=

# user with access to the vhost /narrativ. Also read by the media worker.
RABBITMQ_USERNAME=narrativ
RABBITMQ_NARRATIV_PASSWORD=

# password of the dedicated prod redis (port 6380, started with --requirepass)
REDIS_PASSWORD=

MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=

# base64 key that signs the JWTs. Must differ from dev: whoever has it can forge an admin token. e.g. openssl rand -base64 32
SECRET_KEY=

# access key limited to the bucket narrativ. Also read by the media worker.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
