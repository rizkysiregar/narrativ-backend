<configuration>

    <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="./logs"/>

    <!-- Console JSON logs -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
<!--            <customFields>{"app":"feedzmore-app"}</customFields>-->
            <includeLevelValue>false</includeLevelValue>
            <fieldNames>
                <trace>traceId</trace>
                <span>spanId</span>
            </fieldNames>
        </encoder>
    </appender>

    <!-- File JSON logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/application.json.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
<!--            <customFields>{"app":"feedzmore-app"}</customFields>-->
            <includeLevelValue>false</includeLevelValue>
            <fieldNames>
                <trace>traceId</trace>
                <span>spanId</span>
            </fieldNames>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/application.%d{yyyy-MM-dd}.%i.json.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFileNamingAndTriggeringPolicy">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>