# Local environment: the app on your machine, the infrastructure from docker-compose.yml.
#   cp .env.local.example .env.local
# application.yml imports ./.env and then ./.env.local, so what is set here wins. Every key the "local" profile
# reads is listed, so nothing falls through to the dev values of .env. To work against dev again: remove .env.local.
# Git-ignored; the values below are local-only and not secrets.
SPRING_PROFILES_ACTIVE=local

SERVER_PORT=9091
SERVER_SERVLET_CONTEXT_PATH=/api/v1
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB
SPRING_SERVLET_ENCODING_ENABLED=true
SPRING_SERVLET_ENCODING_CHARSET=UTF-8
SPRING_SERVLET_ENCODING_FORCE=true
SPRING_APPLICATION_NAME=narrativ-service
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1

# Safe to leave empty for local use, unless you test Google sign-in
GOOGLE_CLIENT_ID=
LEGAL_CONTACT_EMAIL=
# REQUIRED: the app refuses to start without Firebase credentials (FirebaseTokenService). Point it at the service
# account key of the DEV Firebase project (kept outside the repo); the local database has no device tokens, so no
# push goes out unless you register a device against your local app.
FIREBASE_CREDENTIALS_FILE=
APP_APPCHECK_MODE=off
APP_APPCHECK_PROJECT_NUMBER=
# plain http on localhost: Safari refuses Secure cookies there, set false when testing the web client in Safari
APP_AUTH_WEB_COOKIE_SECURE=true

APP_RATE_LIMIT_FEED=1000
APP_RATE_LIMIT_POST_CREATE=1000
APP_RATE_LIMIT_POST_UPLOAD=1000
APP_RATE_LIMIT_INTERACTION=1000
APP_RATE_LIMIT_DEFAULT=1000
APP_RATE_LIMIT_AUTH=1000
APP_RATE_LIMIT_AUTH_SESSION=1000
APP_STORAGE_ORPHAN_CLEANUP_ENABLED=false
APP_STORAGE_ORPHAN_CLEANUP_DRY_RUN=true

LOGGING_CONFIG=classpath:logback-spring.xml
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
LOGGING_LEVEL_ORG_FLYWAYDB=INFO
LOGGING_FILE_PATH=./logs
APP_LOGGING_REQUEST_BODY=ERRORS

# no Zipkin locally: nothing is sampled
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.0
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# --- docker-compose.yml ---
POSTGRES_PORT=5432
POSTGRES_DATABASE=narrativ_local
POSTGRES_USER=narrativ
POSTGRES_PASSWORD=narrativ
POSTGRES_CONNECTION_TIMEOUT=20000
POSTGRES_MINIMUM_IDLE=2
POSTGRES_MAXIMUM_POOL_SIZE=10
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_MAX_LIFETIME=90000

REDIS_PORT=6379
REDIS_TIMEOUT=60000

RABBITMQ_PORT=5672
RABBITMQ_USERNAME=narrativ
RABBITMQ_NARRATIV_PASSWORD=narrativ
RABBITMQ_VIRTUAL_HOST=/narrativ-local

# Mailpit inbox: http://localhost:8025
MAIL_PORT=1025

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=narrativ-local
MINIO_ACCESS_KEY=narrativ
MINIO_SECRET_KEY=narrativ-secret

# JWT signing key, base64. Generate your own: openssl rand -base64 64
SECRET_KEY=
