# Copy this file to .env and set values for your development environment.
# The .env file is ignored by Git; do not commit real credentials.
SERVER_PORT=9091
SERVER_SERVLET_CONTEXT_PATH=/api/v1
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB
SPRING_SERVLET_ENCODING_ENABLED=true
SPRING_SERVLET_ENCODING_CHARSET=UTF-8
SPRING_SERVLET_ENCODING_FORCE=true
SPRING_APPLICATION_NAME=feedzmore-service
SPRING_PROFILES_ACTIVE=local-dev
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1
GOOGLE_CLIENT_ID=
LEGAL_CONTACT_EMAIL=
# path of the Firebase service account key of the dev project (download it from Firebase console, keep it outside the repo)
FIREBASE_CREDENTIALS_FILE=
APP_RATE_LIMIT_FEED=20
APP_RATE_LIMIT_POST_CREATE=20
APP_RATE_LIMIT_POST_UPLOAD=60
APP_RATE_LIMIT_INTERACTION=20
APP_RATE_LIMIT_DEFAULT=20
APP_RATE_LIMIT_AUTH=10
APP_RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP
APP_STORAGE_ORPHAN_CLEANUP_ENABLED=false
APP_STORAGE_ORPHAN_CLEANUP_DRY_RUN=true
APP_MESSAGING_IDEMPOTENCY_TTL_SECONDS=86400
LOGGING_CONFIG=classpath:logback-spring.xml
LOGGING_LEVEL_ORG_FLYWAYDB=DEBUG
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

DEV_INFRA_HOST=192.168.1.50
POSTGRES_PORT=5433
POSTGRES_DATABASE=feedzmore
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_CONNECTION_TIMEOUT=20000
POSTGRES_MINIMUM_IDLE=10
POSTGRES_MAXIMUM_POOL_SIZE=20
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_MAX_LIFETIME=90000

REDIS_PORT=6379
REDIS_TIMEOUT=60000

RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_FEEDZMORE_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/feedzmore

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

SECRET_KEY=
LOGGING_FILE_PATH=./logs
ZIPKIN_PORT=9411

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
